/* ========================================
   pages/mall/index.wxss - 福利站（纯色风格）
   ======================================== */

.container {
  min-height: 100vh;
  background: #f5f5f5;
}

/* ── 头部 ── */
.header {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  padding: 32rpx 24rpx 28rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  border-radius: 0 0 32rpx 32rpx;
}

.balance-row {
  display: flex;
  flex-direction: row;
  align-items: stretch;
  justify-content: space-between;
  gap: 20rpx;
  width: 100%;
  box-sizing: border-box;
}

.balance-item {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 20rpx;
  padding: 20rpx 18rpx;
}

.balance-icon {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  flex-shrink: 0;
  font-size: 26rpx;
  font-weight: 700;
  color: #fff;
  text-align: center;
  line-height: 60rpx;
}

.bean-icon {
  background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 100%);
}

.score-icon {
  background: linear-gradient(135deg, #60a5fa 0%, #3b82f6 100%);
}

.balance-info {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  min-width: 0;
  flex: 1;
}

.balance-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
  line-height: 1.3;
  white-space: nowrap;
}

.balance-value {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
  line-height: 1.2;
  margin-top: 4rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 100%;
}

/* 货币双轨切换 */
.currency-display {
  display: flex;
  align-items: center;
  gap: 0;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 20rpx;
  padding: 6rpx;
}

.currency-item {
  flex: 1;
}

.currency-inner {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 14rpx 16rpx;
  border-radius: 16rpx;
  transition: all 0.3s;
  opacity: 0.6;
}

.currency-inner.active {
  background: rgba(255, 255, 255, 0.25);
  opacity: 1;
}

.currency-icon {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 700;
  color: #fff;
}

.yuedou-item .currency-icon {
  background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 100%);
}

.score-item .currency-icon {
  background: linear-gradient(135deg, #60a5fa 0%, #3b82f6 100%);
}

.currency-info {
  display: flex;
  flex-direction: column;
}

.currency-label {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.7);
}

.currency-value {
  font-size: 34rpx;
  font-weight: 700;
  color: #fff;
}

.currency-divider {
  width: 1rpx;
  height: 50rpx;
  background: rgba(255, 255, 255, 0.2);
  margin: 0 4rpx;
}

.btn-records {
  background: rgba(255, 255, 255, 0.2);
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  color: #fff;
  font-size: 24rpx;
  padding: 14rpx 24rpx;
  border-radius: 999rpx;
  line-height: 1.4;
  margin: 0;
}

/* ── 商城说明 ── */
.mall-tip {
  background: #ffffff;
  padding: 18rpx 32rpx;
  border-bottom: 1rpx solid #eeeeee;
}

.tip-text {
  font-size: 24rpx;
  color: #666666;
}

/* ── 分类 ── */
.category-tabs {
  display: flex;
  background: #ffffff;
  padding: 0 16rpx;
  border-bottom: 1rpx solid #eeeeee;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 28rpx 0;
  font-size: 28rpx;
  color: #666666;
  position: relative;
  transition: all 0.2s;
}

.tab-item.active {
  color: #1a73e8;
  font-weight: 700;
}

.tab-item.active::after {
  content: "";
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 4rpx;
  background: #1a73e8;
  border-radius: 2rpx;
}

/* ── 商品列表 ── */
.goods-list {
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.goods-card {
  background: #ffffff;
  border-radius: 16rpx;
  overflow: hidden;
  display: flex;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
  transition: all 0.3s ease;
}

.goods-card:active {
  transform: scale(0.98);
}

.goods-image {
  width: 200rpx;
  height: 200rpx;
  flex-shrink: 0;
  background: #f5f5f5;
  position: relative;
}

.goods-image image {
  width: 100%;
  height: 100%;
}

.goods-image-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  font-weight: 700;
  color: #cccccc;
  background: #fafafa;
}

.goods-currency-tag {
  position: absolute;
  top: 12rpx;
  left: 12rpx;
  font-size: 20rpx;
  font-weight: 700;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  color: #ffffff;
}

.goods-currency-tag.tag-yuedou {
  background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 100%);
}

.goods-currency-tag.tag-score {
  background: linear-gradient(135deg, #60a5fa 0%, #3b82f6 100%);
}

.goods-info {
  flex: 1;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.goods-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #333333;
}

.goods-desc {
  font-size: 24rpx;
  color: #999999;
  margin-top: 10rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.goods-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: auto;
}

.goods-price {
  font-size: 34rpx;
  font-weight: 700;
}

.goods-price.price-yuedou {
  color: #f59e0b;
}

.goods-price.price-score {
  color: #3b82f6;
}

.goods-stock {
  font-size: 22rpx;
  color: #16a34a;
  background: #dcfce7;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
}

.goods-stock.empty {
  color: #ef4444;
  background: #fee2e2;
}

/* ── 空状态 ── */
.empty-tip,
.loading-tip {
  text-align: center;
  padding: 120rpx 0;
  color: #999999;
  font-size: 28rpx;
}

/* ── 球房选择条 ── */
.venue-selector-bar {
  background: #ffffff;
  padding: 20rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid #eeeeee;
}

.venue-current {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
  flex: 1;
}

.venue-current-name {
  font-size: 28rpx;
  color: #333333;
  font-weight: 600;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.venue-current-count {
  font-size: 22rpx;
  color: #999999;
  flex-shrink: 0;
}

.venue-picker-arrow {
  flex-shrink: 0;
  margin-left: 12rpx;
}

.arrow-icon {
  font-size: 24rpx;
  color: #999999;
}

/* ── 球房弹层 ── */
.venue-picker-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 999;
  opacity: 0;
  transition: opacity 0.25s ease;
  pointer-events: none;
}

.venue-picker-mask.show {
  opacity: 1;
  pointer-events: auto;
}

.venue-picker-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  max-height: 75vh;
  display: flex;
  flex-direction: column;
  transform: translateY(100%);
  transition: transform 0.3s cubic-bezier(0.36, 0.66, 0.56, 0.83);
  z-index: 1000;
}

.venue-picker-panel.slide-up {
  transform: translateY(0);
}

.venue-picker-panel.slide-down {
  transform: translateY(100%);
}

/* 标题栏 */
.picker-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 32rpx 24rpx;
  border-bottom: 1rpx solid #eeeeee;
  flex-shrink: 0;
}

.picker-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #333333;
}

.picker-close {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: #f5f5f5;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: #666666;
  line-height: 1;
}

.picker-search-wrap {
  padding: 20rpx 32rpx;
  border-bottom: 1rpx solid #eeeeee;
  flex-shrink: 0;
}

.venue-rule-tip {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  padding: 20rpx 32rpx;
  background: #fffbeb;
  border-bottom: 1rpx solid #fde68a;
  flex-shrink: 0;
}

.rule-icon {
  font-size: 34rpx;
  flex-shrink: 0;
  margin-top: 0rpx;
  line-height: 1.5;
}

.rule-text {
  font-size: 26rpx;
  color: #333333;
  line-height: 1.5;
  font-weight: 500;
}

.picker-search {
  background: #f5f5f5;
  border: 1rpx solid #e0e0e0;
  border-radius: 20rpx;
  padding: 18rpx 24rpx;
  font-size: 28rpx;
  color: #333333;
}

.picker-search::placeholder {
  color: #cccccc;
}

/* 列表 */
.picker-list {
  flex: 1;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
  padding-bottom: env(safe-area-inset-bottom);
}

.picker-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #f5f5f5;
  font-size: 28rpx;
  color: #333333;
  transition: background 0.15s;
}

.picker-item:active {
  background: #f5f5f5;
}

.picker-item.active {
  color: #1a73e8;
  font-weight: 700;
}

.picker-item-inner {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
}

.picker-item-name {
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.picker-item-count {
  font-size: 22rpx;
  color: #999999;
  flex-shrink: 0;
}

.picker-check {
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: 28rpx;
  color: #1a73e8;
}

.picker-empty {
  text-align: center;
  padding: 80rpx 0;
  font-size: 28rpx;
  color: #999999;
}

/* ── 空球房状态 ── */
.empty-venues {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 60rpx;
  gap: 24rpx;
}

.empty-icon {
  font-size: 100rpx;
  color: #cccccc;
}

.empty-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #333333;
}

.empty-desc {
  font-size: 28rpx;
  color: #999999;
  text-align: center;
  line-height: 1.6;
}

.btn-primary {
  background: #1a73e8;
  color: #fff;
  font-size: 28rpx;
  padding: 20rpx 60rpx;
  border-radius: 999rpx;
  margin-top: 20rpx;
  border: none;
}

.btn-primary::after {
  border: none;
}

/* ── 货币类型切换 ── */
.currency-section {
  background: #ffffff;
  padding: 0 24rpx;
  border-bottom: 1rpx solid #eeeeee;
}

.currency-tabs {
  display: flex;
  gap: 0;
}

.currency-tab {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  padding: 26rpx 0;
  font-size: 28rpx;
  color: #666666;
  position: relative;
  transition: all 0.2s;
}

.currency-tab.active {
  color: #1a73e8;
  font-weight: 700;
}

.currency-tab.active::after {
  content: "";
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 80rpx;
  height: 4rpx;
  background: #1a73e8;
  border-radius: 2rpx;
}

.tab-icon {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18rpx;
  font-weight: 700;
  color: #fff;
  background: #e0e0e0;
}

.currency-tab.active.tab-score .tab-icon {
  background: linear-gradient(135deg, #60a5fa 0%, #3b82f6 100%);
}

.currency-tab.active.tab-yuedou .tab-icon {
  background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 100%);
}

/* ── 约豆专区敬请期待 ── */
.coming-soon-panel {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 60rpx;
  margin: 24rpx;
  background: #ffffff;
  border: 1rpx solid #eeeeee;
  border-radius: 20rpx;
}

.coming-soon-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.coming-soon-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #333333;
  margin-bottom: 14rpx;
}

.coming-soon-desc {
  font-size: 26rpx;
  color: #999999;
  text-align: center;
  line-height: 1.6;
}

/* ── 球房专属标签 ── */
.venue-badge {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  font-size: 18rpx;
  font-weight: 700;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
}

/* ── 头部下方操作按钮 ── */
.header-actions {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  width: 100%;
  box-sizing: border-box;
  margin-top: 0;
}

.btn-action {
  flex: 1;
  min-width: 0;
  background: rgba(255, 255, 255, 0.25);
  color: #fff;
  font-size: 24rpx;
  padding: 16rpx 12rpx;
  border-radius: 16rpx;
  line-height: 1.35;
  margin: 0;
  box-sizing: border-box;
}

.btn-action.secondary {
  background: rgba(255, 255, 255, 0.15);
}

/* 说明条 */
.tip-bar {
  background: #ffffff;
  padding: 18rpx 24rpx;
  border-bottom: 1rpx solid #eeeeee;
}

.tip-bar .tip-text {
  font-size: 24rpx;
  color: #666666;
  line-height: 1.5;
  display: block;
  margin-bottom: 12rpx;
}

.marquee-wrap {
  width: 100%;
  height: 44rpx;
  overflow: hidden;
  position: relative;
}

.marquee-track {
  display: inline-flex;
  flex-direction: row;
  flex-wrap: nowrap;
  white-space: nowrap;
  animation: mall-marquee 18s linear infinite;
}

.marquee-text {
  font-size: 26rpx;
  color: #666666;
  line-height: 44rpx;
}

@keyframes mall-marquee {
  0% { transform: translateX(0); }
  100% { transform: translateX(-50%); }
}
