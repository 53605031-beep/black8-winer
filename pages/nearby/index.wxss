/* ========================================
   pages/nearby/index.wxss - 附近球房 Glassmorphism
   ======================================== */

page {
  background: transparent;
  color: #ffffff;
}

.container {
  padding: 24rpx;
}

/* 搜索栏 - 玻璃态版本 */
.search-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  background: rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(16px);
  border: 1rpx solid rgba(255, 255, 255, 0.25);
  border-radius: 24rpx;
  margin-bottom: 24rpx;
}

.search-icon {
  font-size: 32rpx;
  opacity: 0.7;
  flex-shrink: 0;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #ffffff;
  background: transparent;
  border: none;
  outline: none;
}

.search-input::placeholder {
  color: rgba(255, 255, 255, 0.5);
}

/* 球房卡片 - 玻璃态版本 */
.venue-card {
  background: rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1rpx solid rgba(255, 255, 255, 0.25);
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 32rpx rgba(31, 38, 135, 0.15);
  transition: all 0.3s ease;
}

.venue-card:active {
  transform: scale(0.98);
  background: rgba(255, 255, 255, 0.25);
}

.venue-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.venue-name {
  font-size: 34rpx;
  font-weight: 700;
  color: #ffffff;
  flex: 1;
}

.distance-tag {
  background: rgba(6, 182, 212, 0.3);
  backdrop-filter: blur(8px);
  border: 1rpx solid rgba(6, 182, 212, 0.4);
  border-radius: 999rpx;
  padding: 6rpx 14rpx;
  font-size: 22rpx;
  color: #ffffff;
  white-space: nowrap;
  margin-left: 16rpx;
}

.venue-info {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-bottom: 16rpx;
}

.info-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.75);
}

.info-icon {
  font-size: 28rpx;
  opacity: 0.8;
}

/* 标签组 */
.tag-group {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.tag-item {
  background: rgba(255, 255, 255, 0.15);
  backdrop-filter: blur(8px);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  border-radius: 999rpx;
  padding: 6rpx 14rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 60rpx;
  gap: 24rpx;
}

.empty-icon {
  font-size: 100rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 30rpx;
  color: rgba(255, 255, 255, 0.7);
  text-align: center;
}

/* 筛选按钮 - 玻璃态版本 */
.filter-bar {
  display: flex;
  gap: 12rpx;
  margin-bottom: 20rpx;
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
}

.filter-bar::-webkit-scrollbar {
  display: none;
}

.filter-chip {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 12rpx 20rpx;
  background: rgba(255, 255, 255, 0.15);
  backdrop-filter: blur(8px);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  border-radius: 999rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  white-space: nowrap;
  flex-shrink: 0;
  transition: all 0.2s ease;
}

.filter-chip.active {
  background: linear-gradient(135deg, #06b6d4 0%, #0891b2 100%);
  border-color: transparent;
  color: #ffffff;
  box-shadow: 0 4rpx 12rpx rgba(6, 182, 212, 0.3);
}

/* 定位按钮 - 玻璃态版本 */
.location-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 20rpx;
  background: rgba(59, 130, 246, 0.3);
  backdrop-filter: blur(12px);
  border: 1rpx solid rgba(59, 130, 246, 0.4);
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #ffffff;
  margin-bottom: 20rpx;
}

.location-icon {
  font-size: 28rpx;
}
