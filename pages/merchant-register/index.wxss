/* ========================================
   pages/merchant-register/index.wxss - 商家入驻 Glassmorphism
   ======================================== */

page {
  background: transparent;
  color: #ffffff;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.85);
  margin-bottom: 16rpx;
  padding-left: 6rpx;
}

.section-title + .card {
  margin-top: 0;
}

.field-row {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.1);
}

.field-row:last-child {
  border-bottom: none;
}

.field-label {
  width: 170rpx;
  flex-shrink: 0;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
}

.field-input {
  flex: 1;
  font-size: 28rpx;
  color: #ffffff;
  text-align: right;
  background: transparent;
  border: none;
  outline: none;
}

.field-input::placeholder {
  color: rgba(255, 255, 255, 0.4);
}

.field-textarea {
  flex: 1;
  font-size: 28rpx;
  color: #ffffff;
  min-height: 120rpx;
  width: 100%;
  box-sizing: border-box;
  background: rgba(255, 255, 255, 0.1);
  backdrop-filter: blur(12px);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  border-radius: 12rpx;
  padding: 16rpx;
}

.field-textarea::placeholder {
  color: rgba(255, 255, 255, 0.4);
}

.tip-row {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  margin-top: 20rpx;
  padding: 18rpx;
  background: rgba(59, 130, 246, 0.15);
  backdrop-filter: blur(12px);
  border: 1rpx solid rgba(59, 130, 246, 0.25);
  border-radius: 16rpx;
}

.tip-icon {
  flex-shrink: 0;
  margin-top: 2rpx;
  font-size: 28rpx;
}

.tip-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  line-height: 1.6;
}

.tags-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.tag-btn {
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.1);
  backdrop-filter: blur(8px);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  color: rgba(255, 255, 255, 0.8);
  font-size: 26rpx;
  transition: all 0.2s;
}

.tag-btn-active {
  background: linear-gradient(135deg, #06b6d4 0%, #0891b2 100%);
  border-color: transparent;
  color: #ffffff;
  box-shadow: 0 4rpx 12rpx rgba(6, 182, 212, 0.3);
}

.location-btn-wrap {
  margin-top: 20rpx;
  position: relative;
  z-index: 10;
}

.location-btn {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx;
  background: rgba(59, 130, 246, 0.2);
  backdrop-filter: blur(16px);
  border: 1rpx solid rgba(59, 130, 246, 0.3);
  border-radius: 20rpx;
  position: relative;
}

.location-btn-icon {
  flex-shrink: 0;
  font-size: 40rpx;
}

.location-btn-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #ffffff;
}

.location-btn-sub {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-top: 6rpx;
}

.location-btn-arrow {
  margin-left: auto;
  font-size: 36rpx;
  color: rgba(255, 255, 255, 0.6);
  font-weight: 300;
}

.location-info {
  margin-top: 14rpx;
  font-size: 22rpx;
  padding-left: 6rpx;
  color: rgba(255, 255, 255, 0.6);
}

/* 申请状态面板 - 玻璃态版本 */
.status-panel {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 32rpx 60rpx;
  text-align: center;
  background: rgba(255, 255, 255, 0.15);
  backdrop-filter: blur(20px);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  border-radius: 28rpx;
  margin-bottom: 24rpx;
}

.status-icon {
  margin-bottom: 32rpx;
  font-size: 80rpx;
}

.status-title {
  font-size: 38rpx;
  font-weight: 700;
  color: #ffffff;
  margin-bottom: 16rpx;
}

.status-sub {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.75);
  line-height: 1.7;
  max-width: 520rpx;
}

.status-detail {
  width: 100%;
  max-width: 520rpx;
  margin-top: 36rpx;
  background: rgba(255, 255, 255, 0.1);
  backdrop-filter: blur(16px);
  border-radius: 20rpx;
  padding: 24rpx;
}

.detail-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14rpx 0;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
}

.detail-row + .detail-row {
  border-top: 1rpx solid rgba(255, 255, 255, 0.1);
}

.location-btn-real {
  width: 100%;
  display: flex;
  align-items: center;
  background: transparent;
  border: none;
  padding: 0;
  margin: 0;
  border-radius: 0;
  box-shadow: none;
  text-align: left;
  line-height: 1;
  position: relative;
  z-index: 10;
}

/* 通用卡片覆盖 */
.card {
  background: rgba(255, 255, 255, 0.18);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(31, 38, 135, 0.15);
  color: #ffffff;
}

.card + .card {
  margin-top: 20rpx;
}

/* 按钮覆盖 */
.btn-primary {
  background: linear-gradient(135deg, #06b6d4 0%, #0891b2 100%);
  color: #ffffff;
  border: none;
  border-radius: 20rpx;
  padding: 22rpx 32rpx;
  font-size: 32rpx;
  font-weight: 700;
  box-shadow: 0 8rpx 24rpx rgba(6, 182, 212, 0.4);
}

.btn-primary::after {
  border: none;
}

/* 底部安全区 */
.safe-area-bottom {
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}
