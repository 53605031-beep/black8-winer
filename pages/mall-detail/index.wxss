/* ========================================
   pages/mall-detail/index.wxss - 商品详情 Glassmorphism
   ======================================== */

.container {
  min-height: 100vh;
  background: transparent;
  padding-bottom: 140rpx;
}

.loading-wrap {
  text-align: center;
  padding: 200rpx 0;
  color: rgba(255, 255, 255, 0.6);
}

/* ── 商品图片 ── */
.goods-image {
  width: 100%;
  height: 500rpx;
  background: rgba(255, 255, 255, 0.1);
  position: relative;
}

.goods-image image {
  width: 100%;
  height: 100%;
}

.image-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 120rpx;
  font-weight: 700;
  color: rgba(255, 255, 255, 0.3);
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.1) 0%, rgba(255, 255, 255, 0.05) 100%);
}

.goods-currency-badge {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  font-size: 24rpx;
  font-weight: 700;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  color: #ffffff;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.2);
}

.badge-yuedou {
  background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 100%);
}

.badge-score {
  background: linear-gradient(135deg, #60a5fa 0%, #3b82f6 100%);
}

/* ── 商品卡片 - 玻璃态版本 ── */
.goods-card {
  background: rgba(255, 255, 255, 0.18);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  border-radius: 24rpx;
  padding: 32rpx;
  margin: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(31, 38, 135, 0.15);
}

.goodsName {
  font-size: 38rpx;
  font-weight: 700;
  color: #ffffff;
  margin-bottom: 16rpx;
}

.goods-price-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
  flex-wrap: wrap;
}

.goods-price {
  font-size: 42rpx;
  font-weight: 700;
}

.goods-price.price-yuedou {
  color: #fbbf24;
}

.goods-price.price-score {
  color: #60a5fa;
}

.goods-stock {
  font-size: 22rpx;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
}

.goods-stock.ok {
  background: rgba(74, 222, 128, 0.25);
  backdrop-filter: blur(8px);
  border: 1rpx solid rgba(74, 222, 128, 0.4);
  color: #4ade80;
}

.goods-stock.empty {
  background: rgba(248, 113, 113, 0.25);
  backdrop-filter: blur(8px);
  border: 1rpx solid rgba(248, 113, 113, 0.4);
  color: #f87171;
}

.goods-category {
  font-size: 22rpx;
  background: rgba(255, 255, 255, 0.15);
  backdrop-filter: blur(8px);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  color: rgba(255, 255, 255, 0.8);
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
}

.goods-desc {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.75);
  line-height: 1.6;
}

/* ── 球房专属提示 - 玻璃态版本 ── */
.venue-permission-tip {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: rgba(251, 191, 36, 0.15);
  backdrop-filter: blur(12px);
  margin: 0 24rpx;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  border: 1rpx solid rgba(251, 191, 36, 0.25);
}

.tip-icon {
  font-size: 32rpx;
  flex-shrink: 0;
}

.tip-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
  line-height: 1.5;
}

/* ── 余额提示 - 玻璃态版本 ── */
.balance-tip {
  background: rgba(255, 255, 255, 0.15);
  backdrop-filter: blur(16px);
  margin: 24rpx;
  border-radius: 20rpx;
  padding: 24rpx;
}

.balance-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
}

.balance-val {
  font-size: 38rpx;
  font-weight: 700;
}

.balance-val.ok {
  color: #4ade80;
}

.balance-val.warn {
  color: #f87171;
}

.need-row {
  text-align: right;
  font-size: 24rpx;
  color: #f87171;
  margin-top: 8rpx;
}

/* ── 底部按钮 - 玻璃态版本 ── */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(30, 41, 59, 0.9);
  backdrop-filter: blur(24px);
  -webkit-backdrop-filter: blur(24px);
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -8rpx 32rpx rgba(0, 0, 0, 0.2);
  border-top: 1rpx solid rgba(255, 255, 255, 0.1);
}

.btn-redeem {
  width: 100%;
  background: linear-gradient(135deg, #06b6d4 0%, #0891b2 100%);
  color: #fff;
  font-size: 34rpx;
  font-weight: 700;
  border-radius: 999rpx;
  padding: 26rpx 0;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(6, 182, 212, 0.4);
}

.btn-redeem.disabled {
  background: rgba(255, 255, 255, 0.15);
  color: rgba(255, 255, 255, 0.4);
  box-shadow: none;
}

/* ── 弹窗 - 玻璃态版本 ── */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.2s;
  z-index: 100;
}

.modal-mask.show {
  opacity: 1;
  pointer-events: auto;
}

.modal-box {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(30, 41, 59, 0.98);
  backdrop-filter: blur(24px);
  -webkit-backdrop-filter: blur(24px);
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  transform: translateY(100%);
  transition: transform 0.3s;
  z-index: 101;
  border-top: 1rpx solid rgba(255, 255, 255, 0.1);
}

.modal-box.show {
  transform: translateY(0);
}

.modal-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #ffffff;
  text-align: center;
  margin-bottom: 32rpx;
}

.form-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.1);
}

.form-label {
  width: 140rpx;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
  flex-shrink: 0;
}

.form-input {
  flex: 1;
  font-size: 28rpx;
  color: #ffffff;
  padding: 0;
  background: transparent;
  border: none;
}

.form-input::placeholder {
  color: rgba(255, 255, 255, 0.4);
}

.modal-tip {
  text-align: center;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
  margin: 24rpx 0;
}

.modal-btns {
  display: flex;
  gap: 16rpx;
}

.btn-cancel {
  flex: 1;
  background: rgba(255, 255, 255, 0.15);
  backdrop-filter: blur(12px);
  color: rgba(255, 255, 255, 0.8);
  font-size: 30rpx;
  border-radius: 999rpx;
  padding: 24rpx 0;
  border: none;
}

.btn-confirm {
  flex: 1;
  background: linear-gradient(135deg, #06b6d4 0%, #0891b2 100%);
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
  border-radius: 999rpx;
  padding: 24rpx 0;
  border: none;
  box-shadow: 0 4rpx 16rpx rgba(6, 182, 212, 0.35);
}

.btn-confirm.confirm-yuedou {
  background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 100%);
  box-shadow: 0 4rpx 16rpx rgba(251, 191, 36, 0.35);
}

.btn-confirm.confirm-score {
  background: linear-gradient(135deg, #60a5fa 0%, #3b82f6 100%);
  box-shadow: 0 4rpx 16rpx rgba(59, 130, 246, 0.35);
}
