<view class="container">
  <!-- 加载状态 -->
  <view wx:if="{{loading}}" class="loading-wrap">
    <text>加载中...</text>
  </view>

  <block wx:else>
    <!-- 商品图片 -->
    <view class="goods-image">
      <image wx:if="{{goods.image}}" src="{{goods.image}}" mode="aspectFill" />
      <view wx:else class="image-placeholder">{{goods.name.substring(0,1)}}</view>
      <view class="goods-currency-badge {{goods.currencyType === 'yuedou' ? 'badge-yuedou' : 'badge-score'}}">
        {{goods.currencyType === 'yuedou' ? '约豆兑换' : '积分兑换'}}
      </view>
    </view>

    <!-- 商品信息 -->
    <view class="goods-card">
      <view class="goods-name">{{goods.name}}</view>
      <view class="goods-price-row">
        <text class="goods-price {{goods.currencyType === 'yuedou' ? 'price-yuedou' : 'price-score'}}">{{goods.price}} {{goods.currencyType === 'yuedou' ? '约豆' : '积分'}}</text>
        <text class="goods-stock {{goods.stock > 0 ? 'ok' : 'empty'}}">
          {{goods.stock > 0 ? '库存 '+goods.stock : '已售罄'}}
        </text>
        <text class="goods-category">{{goods.category === 'virtual' ? '虚拟物品' : '实物'}}</text>
      </view>
      <view class="goods-desc">{{goods.description || '暂无描述'}}</view>
    </view>

    <!-- 球房专属提示 -->
    <view class="venue-permission-tip" wx:if="{{goods.venueId}}">
      <text class="tip-icon">🏏</text>
      <text class="tip-text">此为球房专属福利，仅参与过该球房比赛的球友可兑换</text>
    </view>

    <!-- 余额提示 -->
    <view class="balance-tip">
      <view class="balance-row">
        <text>{{currencyLabel}}余额</text>
        <text class="balance-val {{balanceEnough ? 'ok' : 'warn'}}">{{balance}}</text>
      </view>
      <view class="need-row" wx:if="{{!balanceEnough}}">
        还需 {{goods.price - balance}} {{currencyLabel}}，去打球赢得更多！
      </view>
    </view>

    <!-- 底部按钮 -->
    <view class="bottom-bar">
      <button
        class="btn-redeem {{balanceEnough && goods.stock > 0 ? '' : 'disabled'}}"
        bindtap="onRedeem"
        disabled="{{!balanceEnough || goods.stock <= 0}}"
      >
        {{goods.stock <= 0 ? '已售罄' : (!balanceEnough ? currencyLabel+'不足' : '立即兑换')}}
      </button>
    </view>
  </block>

  <!-- 收货地址弹窗（实物） -->
  <view class="modal-mask {{showRedeemModal ? 'show' : ''}}" bindtap="hideRedeemModal"></view>
  <view class="modal-box {{showRedeemModal ? 'show' : ''}}">
    <view class="modal-title">填写收货地址</view>
    <view class="form-item">
      <text class="form-label">收货人</text>
      <input class="form-input" placeholder="请输入姓名" data-field="name" value="{{redeemForm.name}}" bindinput="onFormInput" />
    </view>
    <view class="form-item">
      <text class="form-label">手机号</text>
      <input class="form-input" type="number" placeholder="请输入手机号" maxlength="11" data-field="phone" value="{{redeemForm.phone}}" bindinput="onFormInput" />
    </view>
    <view class="form-item">
      <text class="form-label">收货地址</text>
      <input class="form-input" placeholder="请输入详细地址" data-field="address" value="{{redeemForm.address}}" bindinput="onFormInput" />
    </view>
    <view class="modal-tip">确认后将扣除 {{goods.price}} {{currencyLabel}}</view>
    <view class="modal-btns">
      <button class="btn-cancel" bindtap="hideRedeemModal">取消</button>
      <button class="btn-confirm {{goods.currencyType === 'yuedou' ? 'confirm-yuedou' : 'confirm-score'}}" bindtap="onConfirmRedeem">确认兑换</button>
    </view>
  </view>
</view>
