/* ========================================
   pages/venue-detail/index.wxss - 球房详情 Glassmorphism
   ======================================== */

/* 球房头部 - 玻璃态深色版本 */
.venue-header {
  background: rgba(102, 126, 234, 0.4);
  backdrop-filter: blur(24px);
  -webkit-backdrop-filter: blur(24px);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  border-radius: 0 0 32rpx 32rpx;
  padding: 32rpx 24rpx;
  color: #ffffff;
}

.venue-name {
  font-size: 40rpx;
  font-weight: 700;
  color: #ffffff;
  margin-bottom: 12rpx;
}

.venue-address {
  flex: 1;
  color: rgba(255, 255, 255, 0.7) !important;
}

.distance-tag {
  background: rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(8px);
  border: 1rpx solid rgba(255, 255, 255, 0.25);
  border-radius: 999rpx;
  padding: 6rpx 16rpx;
  font-size: 22rpx;
  color: #ffffff;
  white-space: nowrap;
}

.action-bar {
  margin-top: 24rpx;
  display: flex;
  gap: 16rpx;
}

.action-main {
  flex: 1;
}

.action-sub {
  width: 200rpx;
  margin-left: 0;
}

/* 操作按钮 - 玻璃态版本 */
.btn-primary {
  background: linear-gradient(135deg, #06b6d4 0%, #0891b2 100%);
  color: #ffffff;
  border: none;
  border-radius: 20rpx;
  padding: 20rpx 28rpx;
  font-size: 30rpx;
  font-weight: 700;
  box-shadow: 0 8rpx 24rpx rgba(6, 182, 212, 0.35);
}

.btn-primary::after {
  border: none;
}

.btn-ghost {
  background: rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(12px);
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  border-radius: 20rpx;
  color: #ffffff;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
}

.btn-ghost::after {
  border: none;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #ffffff;
  margin: 32rpx 0 18rpx;
  padding-left: 6rpx;
}

.match-item {
  cursor: pointer;
  background: rgba(255, 255, 255, 0.15);
  backdrop-filter: blur(16px);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  border-radius: 20rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
  transition: all 0.2s ease;
}

.match-item:active {
  background: rgba(255, 255, 255, 0.2);
}

.match-time {
  font-size: 32rpx;
  font-weight: 700;
  color: #ffffff;
}

.headcount-badge {
  display: inline-block;
  background: rgba(6, 182, 212, 0.4);
  backdrop-filter: blur(8px);
  border: 1rpx solid rgba(6, 182, 212, 0.5);
  border-radius: 999rpx;
  padding: 6rpx 16rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #ffffff;
}

.empty-state {
  text-align: center;
  padding: 60rpx 24rpx;
  background: rgba(255, 255, 255, 0.1);
  backdrop-filter: blur(16px);
  border: 1rpx solid rgba(255, 255, 255, 0.15);
  border-radius: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.65);
}

.owner-badge {
  display: inline-block;
  margin-top: 16rpx;
  padding: 6rpx 18rpx;
  background: rgba(251, 191, 36, 0.25);
  backdrop-filter: blur(8px);
  border: 1rpx solid rgba(251, 191, 36, 0.35);
  border-radius: 999rpx;
  font-size: 22rpx;
  color: #ffffff;
}

.btn-owner {
  width: 160rpx;
  background: rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(12px);
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  border-radius: 20rpx;
  color: #ffffff;
  font-size: 28rpx;
  padding: 16rpx;
  line-height: 1;
}

.merchant-actions {
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.1);
  display: flex;
  justify-content: flex-end;
  gap: 12rpx;
}

.btn-ghost-danger {
  color: #f87171 !important;
  border-color: rgba(248, 113, 113, 0.4) !important;
  background: rgba(248, 113, 113, 0.15) !important;
}

/* 通用卡片覆盖 */
.card {
  background: rgba(255, 255, 255, 0.18);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(31, 38, 135, 0.15);
  color: #ffffff;
}

.card + .card {
  margin-top: 20rpx;
}

.muted {
  color: rgba(255, 255, 255, 0.65) !important;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.badge {
  background: rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(8px);
  border: 1rpx solid rgba(255, 255, 255, 0.25);
  border-radius: 999rpx;
  padding: 6rpx 14rpx;
  font-size: 22rpx;
  color: #ffffff;
}
