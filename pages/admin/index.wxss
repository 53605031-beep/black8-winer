/* ========================================
   pages/admin/index.wxss - 管理员后台 Glassmorphism
   ======================================== */

/* Tab切换 - 玻璃态版本 */
.tab-bar {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
  background: rgba(255, 255, 255, 0.15);
  backdrop-filter: blur(16px);
  border-radius: 20rpx;
  padding: 8rpx;
  box-shadow: 0 4rpx 20rpx rgba(31, 38, 135, 0.15);
}

.tab {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 16rpx 0;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.7);
  border-radius: 16rpx;
  position: relative;
  transition: all 0.2s;
}

.tab-active {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #ffffff;
  font-weight: 600;
  box-shadow: 0 4rpx 16rpx rgba(102, 126, 234, 0.35);
}

.tab-badge {
  background: rgba(239, 68, 68, 0.4);
  backdrop-filter: blur(8px);
  color: #ffffff;
  font-size: 20rpx;
  padding: 0 10rpx;
  border-radius: 999rpx;
  min-width: 36rpx;
  text-align: center;
  line-height: 36rpx;
}

.tab-right {
  padding: 0 8rpx;
}

/* 申请卡片 - 玻璃态版本 */
.app-card {
  background: rgba(255, 255, 255, 0.18);
  backdrop-filter: blur(20px);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 32rpx rgba(31, 38, 135, 0.15);
}

.app-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.app-info {
  background: rgba(255, 255, 255, 0.1);
  backdrop-filter: blur(12px);
  border-radius: 16rpx;
  padding: 18rpx 22rpx;
  margin-bottom: 18rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
}

.info-row + .info-row {
  border-top: 1rpx solid rgba(255, 255, 255, 0.1);
}

.tags-inline {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  justify-content: flex-end;
}

.app-actions {
  display: flex;
  gap: 16rpx;
  justify-content: flex-end;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
  gap: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.6);
}

/* 状态胶囊 - 玻璃态版本 */
.badge-orange {
  background: rgba(251, 146, 60, 0.3);
  backdrop-filter: blur(8px);
  border: 1rpx solid rgba(251, 146, 60, 0.4);
  color: #ffffff;
  border-radius: 999rpx;
  padding: 4rpx 12rpx;
  font-size: 22rpx;
}

.badge-green {
  background: rgba(34, 197, 94, 0.3);
  backdrop-filter: blur(8px);
  border: 1rpx solid rgba(34, 197, 94, 0.4);
  color: #ffffff;
  border-radius: 999rpx;
  padding: 4rpx 12rpx;
  font-size: 22rpx;
}

.badge-red {
  background: rgba(239, 68, 68, 0.3);
  backdrop-filter: blur(8px);
  border: 1rpx solid rgba(239, 68, 68, 0.4);
  color: #ffffff;
  border-radius: 999rpx;
  padding: 4rpx 12rpx;
  font-size: 22rpx;
}

.badge-gray {
  background: rgba(156, 163, 175, 0.3);
  backdrop-filter: blur(8px);
  border: 1rpx solid rgba(156, 163, 175, 0.3);
  color: rgba(255, 255, 255, 0.8);
  border-radius: 999rpx;
  padding: 4rpx 12rpx;
  font-size: 22rpx;
}

/* 商户管理 */
.list-toolbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding: 0 4rpx;
}

.toolbar-hint {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.6);
}

.venue-card {
  margin-bottom: 20rpx;
}

/* 弹窗 - 玻璃态版本 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0);
  z-index: 999;
  pointer-events: none;
  transition: background 0.3s ease;
}

.modal-mask.show {
  background: rgba(0, 0, 0, 0.6);
  pointer-events: auto;
}

.modal-sheet {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(30, 41, 59, 0.95);
  backdrop-filter: blur(24px);
  -webkit-backdrop-filter: blur(24px);
  border-radius: 32rpx 32rpx 0 0;
  padding: 24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  z-index: 1000;
  transform: translateY(100%);
  transition: transform 0.3s ease;
  max-height: 85vh;
  overflow-y: auto;
  border-top: 1rpx solid rgba(255, 255, 255, 0.1);
}

.modal-mask.show .modal-sheet {
  transform: translateY(0);
}

.modal-handle {
  width: 80rpx;
  height: 8rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 4rpx;
  margin: 0 auto 24rpx;
}

.modal-title {
  font-size: 36rpx;
  font-weight: 700;
  text-align: center;
  margin-bottom: 32rpx;
  color: #ffffff;
}

.form-group {
  margin-bottom: 24rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-bottom: 12rpx;
}

.form-input {
  width: 100%;
  height: 88rpx;
  background: rgba(255, 255, 255, 0.1);
  backdrop-filter: blur(12px);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  color: #ffffff;
  box-sizing: border-box;
}

.form-input:focus {
  border-color: rgba(102, 126, 234, 0.6);
  background: rgba(255, 255, 255, 0.15);
}

.form-input::placeholder {
  color: rgba(255, 255, 255, 0.5);
}

.form-row {
  display: flex;
  gap: 20rpx;
}

.form-row .form-group {
  flex: 1;
}

.location-picker {
  display: flex;
  justify-content: space-between;
  align-items: center;
  min-height: 88rpx;
  background: rgba(255, 255, 255, 0.1);
  backdrop-filter: blur(12px);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  border-radius: 16rpx;
  padding: 16rpx 24rpx;
  box-sizing: border-box;
}

.location-picker.picked {
  background: rgba(34, 197, 94, 0.15);
  border-color: rgba(34, 197, 94, 0.4);
}

.location-text {
  flex: 1;
  min-width: 0;
}

.location-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #ffffff;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.location-addr {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
  margin-top: 4rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.location-placeholder {
  font-size: 30rpx;
  color: rgba(255, 255, 255, 0.5);
}

.location-icon {
  font-size: 36rpx;
  flex-shrink: 0;
  margin-left: 12rpx;
  color: rgba(255, 255, 255, 0.6);
}

.tag-selector {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.tag-option {
  padding: 14rpx 26rpx;
  background: rgba(255, 255, 255, 0.1);
  backdrop-filter: blur(8px);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  border-radius: 14rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
  transition: all 0.2s;
}

.tag-option.selected {
  background: linear-gradient(135deg, #06b6d4 0%, #0891b2 100%);
  border-color: transparent;
  color: #ffffff;
  box-shadow: 0 4rpx 12rpx rgba(6, 182, 212, 0.3);
}

.modal-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 32rpx;
  padding-bottom: env(safe-area-inset-bottom);
}

.btn-cancel,
.btn-confirm,
.btn-danger {
  flex: 1;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
  font-size: 32rpx;
  border: none;
}

.btn-cancel {
  background: rgba(255, 255, 255, 0.15);
  backdrop-filter: blur(12px);
  color: rgba(255, 255, 255, 0.8);
}

.btn-confirm {
  background: linear-gradient(135deg, #06b6d4 0%, #0891b2 100%);
  color: #ffffff;
  box-shadow: 0 4rpx 16rpx rgba(6, 182, 212, 0.35);
}

.btn-danger {
  background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
  color: #ffffff;
  box-shadow: 0 4rpx 16rpx rgba(239, 68, 68, 0.35);
}

/* 确认弹窗 */
.confirm-sheet {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%) scale(0.9);
  background: rgba(30, 41, 59, 0.98);
  backdrop-filter: blur(24px);
  border-radius: 28rpx;
  padding: 48rpx 40rpx 40rpx;
  width: 560rpx;
  z-index: 1000;
  opacity: 0;
  transition: all 0.3s ease;
  pointer-events: none;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
}

.modal-mask.show .confirm-sheet {
  transform: translate(-50%, -50%) scale(1);
  opacity: 1;
  pointer-events: auto;
}

.confirm-icon {
  width: 100rpx;
  height: 100rpx;
  background: rgba(239, 68, 68, 0.2);
  backdrop-filter: blur(12px);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 24rpx;
  font-size: 48rpx;
}

.confirm-title {
  font-size: 36rpx;
  font-weight: 700;
  text-align: center;
  margin-bottom: 12rpx;
  color: #ffffff;
}

.confirm-message {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.75);
  text-align: center;
  margin-bottom: 32rpx;
  line-height: 1.6;
}

/* 通用按钮覆盖 */
.btn-primary {
  background: linear-gradient(135deg, #06b6d4 0%, #0891b2 100%);
  color: #ffffff;
  border: none;
  border-radius: 16rpx;
  padding: 18rpx 28rpx;
  font-size: 28rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 16rpx rgba(6, 182, 212, 0.35);
}

.btn-ghost {
  background: rgba(255, 255, 255, 0.15);
  backdrop-filter: blur(12px);
  border: 1rpx solid rgba(255, 255, 255, 0.25);
  border-radius: 16rpx;
  color: #ffffff;
  padding: 18rpx 22rpx;
  font-size: 28rpx;
}
