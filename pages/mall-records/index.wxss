/* ========================================
   pages/mall-records/index.wxss - 兑换记录 Glassmorphism
   ======================================== */

.record-list {
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.record-card {
  background: rgba(255, 255, 255, 0.18);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(31, 38, 135, 0.15);
}

.record-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.goods-thumb {
  width: 100rpx;
  height: 100rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
}

.goods-thumb-placeholder {
  width: 100rpx;
  height: 100rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.1);
  backdrop-filter: blur(12px);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 700;
  color: rgba(255, 255, 255, 0.4);
  flex-shrink: 0;
}

.record-info {
  flex: 1;
}

.goods-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #ffffff;
}

.goods-price {
  font-size: 24rpx;
  margin-top: 6rpx;
}

.goods-price.price-yuedou {
  color: #fbbf24;
}

.goods-price.price-score {
  color: #60a5fa;
}

.status-badge {
  font-size: 24rpx;
  font-weight: 700;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  flex-shrink: 0;
}

.status-badge.wait {
  background: rgba(251, 191, 36, 0.3);
  backdrop-filter: blur(8px);
  border: 1rpx solid rgba(251, 191, 36, 0.4);
  color: #ffffff;
}

.status-badge.shipped {
  background: rgba(59, 130, 246, 0.3);
  backdrop-filter: blur(8px);
  border: 1rpx solid rgba(59, 130, 246, 0.4);
  color: #ffffff;
}

.status-badge.ok {
  background: rgba(34, 197, 94, 0.3);
  backdrop-filter: blur(8px);
  border: 1rpx solid rgba(34, 197, 94, 0.4);
  color: #ffffff;
}

.address-info {
  margin-top: 16rpx;
  padding: 16rpx;
  background: rgba(255, 255, 255, 0.1);
  backdrop-filter: blur(12px);
  border-radius: 12rpx;
}

.address-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  white-space: pre-line;
}

.record-time {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.5);
  text-align: right;
}

.loading-tip,
.empty-tip {
  text-align: center;
  padding: 200rpx 0;
  color: rgba(255, 255, 255, 0.6);
  font-size: 28rpx;
}

.mall-link {
  color: #fbbf24;
  font-size: 28rpx;
  margin-top: 16rpx;
}
