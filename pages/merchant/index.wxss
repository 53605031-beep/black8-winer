/* ========================================
   pages/merchant/index.wxss - 商家管理 Glassmorphism
   ======================================== */

.page {
  padding: 24rpx;
  min-height: 100vh;
  background: transparent;
}

/* 球房栏 - 玻璃态版本 */
.venue-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: rgba(255, 255, 255, 0.18);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(31, 38, 135, 0.15);
}

.venue-name {
  font-size: 34rpx;
  font-weight: 700;
  color: #ffffff;
}

.venue-hint {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
}

/* Tab切换 - 玻璃态版本 */
.tab-bar {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
  background: rgba(255, 255, 255, 0.15);
  backdrop-filter: blur(16px);
  border-radius: 20rpx;
  padding: 8rpx;
  box-shadow: 0 4rpx 20rpx rgba(31, 38, 135, 0.15);
}

.tab {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 16rpx 0;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.7);
  border-radius: 16rpx;
  position: relative;
  transition: all 0.2s;
}

.tab-active {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #ffffff;
  font-weight: 600;
  box-shadow: 0 4rpx 16rpx rgba(102, 126, 234, 0.35);
}

.tab-badge {
  background: rgba(239, 68, 68, 0.4);
  backdrop-filter: blur(8px);
  color: #ffffff;
  font-size: 20rpx;
  padding: 0 10rpx;
  border-radius: 999rpx;
  min-width: 36rpx;
  text-align: center;
  line-height: 36rpx;
}

.toolbar {
  display: flex;
  justify-content: flex-end;
  margin-bottom: 16rpx;
}

.hint {
  text-align: center;
  color: rgba(255, 255, 255, 0.6);
  font-size: 28rpx;
  padding: 60rpx 0;
}

.empty {
  text-align: center;
  color: rgba(255, 255, 255, 0.6);
  font-size: 28rpx;
  padding: 80rpx 0;
}

/* 卡片 - 玻璃态版本 */
.card {
  background: rgba(255, 255, 255, 0.18);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 32rpx rgba(31, 38, 135, 0.15);
  color: #ffffff;
}

.goods-card {}

.goods-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.goods-main {
  flex: 1;
  min-width: 0;
}

.goods-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #ffffff;
  margin-bottom: 10rpx;
}

.goods-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  align-items: center;
}

.price {
  font-size: 28rpx;
  font-weight: 700;
}

.price-yuedou {
  color: #fbbf24;
}

.price-score {
  color: #60a5fa;
}

.stock {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
}

.red-card {}

.red-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.redName {
  font-size: 32rpx;
  font-weight: 700;
  color: #ffffff;
}

.red-body {
  background: rgba(255, 255, 255, 0.1);
  backdrop-filter: blur(12px);
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 16rpx;
}

.row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10rpx 0;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
}

.row + .row {
  border-top: 1rpx solid rgba(255, 255, 255, 0.1);
}

.addr {
  max-width: 380rpx;
  text-align: right;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
  word-break: break-all;
}

.actions {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

/* 标签 - 玻璃态版本 */
.badge {
  font-size: 22rpx;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
}

.badge-on {
  background: rgba(34, 197, 94, 0.3);
  backdrop-filter: blur(8px);
  border: 1rpx solid rgba(34, 197, 94, 0.4);
  color: #ffffff;
}

.badge-off {
  background: rgba(255, 255, 255, 0.15);
  backdrop-filter: blur(8px);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  color: rgba(255, 255, 255, 0.7);
}

.badge-wait {
  background: rgba(251, 146, 60, 0.3);
  backdrop-filter: blur(8px);
  border: 1rpx solid rgba(251, 146, 60, 0.4);
  color: #ffffff;
}

.badge-ship {
  background: rgba(59, 130, 246, 0.3);
  backdrop-filter: blur(8px);
  border: 1rpx solid rgba(59, 130, 246, 0.4);
  color: #ffffff;
}

.badge-cat {
  background: rgba(167, 139, 250, 0.3);
  backdrop-filter: blur(8px);
  border: 1rpx solid rgba(167, 139, 250, 0.4);
  color: #ffffff;
}

.badge-yuedou {
  background: rgba(251, 191, 36, 0.3);
  backdrop-filter: blur(8px);
  border: 1rpx solid rgba(251, 191, 36, 0.4);
  color: #ffffff;
}

.badge-score {
  background: rgba(255, 255, 255, 0.15);
  backdrop-filter: blur(8px);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  color: rgba(255, 255, 255, 0.85);
}

.btn-primary {
  background: linear-gradient(135deg, #06b6d4 0%, #0891b2 100%) !important;
  color: #ffffff !important;
  border-radius: 16rpx !important;
  font-size: 26rpx !important;
  line-height: 1.8;
  border: none;
  box-shadow: 0 4rpx 12rpx rgba(6, 182, 212, 0.3);
}

.btn-ghost {
  background: rgba(255, 255, 255, 0.15) !important;
  backdrop-filter: blur(12px);
  border: 1rpx solid rgba(255, 255, 255, 0.25) !important;
  color: #ffffff !important;
  border-radius: 16rpx !important;
  font-size: 26rpx !important;
  line-height: 1.8;
}

.btn-danger-ghost {
  background: rgba(239, 68, 68, 0.2) !important;
  backdrop-filter: blur(8px);
  border: 1rpx solid rgba(239, 68, 68, 0.4) !important;
  color: #ffffff !important;
  border-radius: 16rpx !important;
  font-size: 26rpx !important;
  line-height: 1.8;
}

/* 弹层 - 玻璃态版本 */
.mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 999;
  display: flex;
  align-items: flex-end;
}

.sheet {
  background: rgba(30, 41, 59, 0.98);
  backdrop-filter: blur(24px);
  -webkit-backdrop-filter: blur(24px);
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx 32rpx 80rpx;
  width: 100%;
  max-height: 85vh;
  overflow-y: auto;
  border-top: 1rpx solid rgba(255, 255, 255, 0.1);
}

.sheet-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #ffffff;
  text-align: center;
  margin-bottom: 32rpx;
}

.field {
  margin-bottom: 24rpx;
}

.field-row {
  display: flex;
  gap: 16rpx;
}

.half {
  flex: 1;
}

.label {
  display: block;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-bottom: 10rpx;
}

.input {
  width: 100%;
  box-sizing: border-box;
  background: rgba(255, 255, 255, 0.1);
  backdrop-filter: blur(12px);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  border-radius: 16rpx;
  padding: 18rpx 20rpx;
  font-size: 28rpx;
  color: #ffffff;
}

.input::placeholder {
  color: rgba(255, 255, 255, 0.5);
}

.textarea {
  width: 100%;
  box-sizing: border-box;
  background: rgba(255, 255, 255, 0.1);
  backdrop-filter: blur(12px);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  border-radius: 16rpx;
  padding: 18rpx 20rpx;
  font-size: 28rpx;
  color: #ffffff;
  min-height: 120rpx;
}

.textarea::placeholder {
  color: rgba(255, 255, 255, 0.5);
}

.seg {
  display: flex;
  gap: 12rpx;
}

.seg-i {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  background: rgba(255, 255, 255, 0.1);
  backdrop-filter: blur(8px);
  border: 1rpx solid rgba(255, 255, 255, 0.15);
  border-radius: 16rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.7);
  transition: all 0.2s;
}

.seg-i.on {
  background: linear-gradient(135deg, #06b6d4 0%, #0891b2 100%);
  color: #ffffff;
  font-weight: 600;
  border-color: transparent;
  box-shadow: 0 4rpx 12rpx rgba(6, 182, 212, 0.3);
}

.sheet-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 32rpx;
}

.wide {
  flex: 1;
}
