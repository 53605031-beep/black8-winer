/* ========================================
   pages/location-picker/index.wxss - 位置选择 Glassmorphism
   ======================================== */

/* 容器 */
.container {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: transparent;
}

/* 加载中 */
.loading-wrap {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  gap: 24rpx;
}

.loading-icon {
  font-size: 64rpx;
  animation: spin 1s linear infinite;
  opacity: 0.7;
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.7);
}

/* 兜底重试 */
.fallback {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  gap: 24rpx;
  padding: 48rpx;
}

.fallback-icon {
  margin-bottom: 12rpx;
  font-size: 80rpx;
  opacity: 0.6;
}

.fallback-text {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.7);
  text-align: center;
  line-height: 1.6;
}

.fallback-btn {
  margin-top: 16rpx;
  padding: 16rpx 48rpx;
  background: linear-gradient(135deg, #06b6d4 0%, #0891b2 100%);
  color: #fff;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(6, 182, 212, 0.4);
}
