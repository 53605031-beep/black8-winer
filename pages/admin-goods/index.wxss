/* ========================================
   pages/admin-goods/index.wxss - 商品管理 Glassmorphism
   ======================================== */

/* 页面容器 */
.page {
  min-height: 100vh;
  padding: 24rpx;
  padding-bottom: 48rpx;
  background: transparent;
  box-sizing: border-box;
}

/* Tab切换 - 玻璃态版本 */
.tab-bar {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 24rpx;
  background: rgba(255, 255, 255, 0.15);
  backdrop-filter: blur(16px);
  border-radius: 20rpx;
  padding: 8rpx;
  box-shadow: 0 4rpx 20rpx rgba(31, 38, 135, 0.15);
}

.tab {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 16rpx 0;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.7);
  border-radius: 16rpx;
  position: relative;
  transition: all 0.2s;
}

.tab-active {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #ffffff;
  font-weight: 600;
  box-shadow: 0 4rpx 16rpx rgba(102, 126, 234, 0.35);
}

.tab-badge {
  background: rgba(239, 68, 68, 0.4);
  backdrop-filter: blur(8px);
  color: #ffffff;
  font-size: 20rpx;
  padding: 0 10rpx;
  border-radius: 999rpx;
  min-width: 36rpx;
  text-align: center;
  line-height: 36rpx;
}

.tab-side {
  padding: 0 8rpx;
}

/* 工具栏 */
.toolbar {
  margin-bottom: 20rpx;
}

/* 按钮 - 玻璃态版本 */
.btn-primary {
  background: linear-gradient(135deg, #06b6d4 0%, #0891b2 100%) !important;
  color: #fff !important;
  border-radius: 20rpx !important;
  font-weight: 600;
  box-shadow: 0 4rpx 16rpx rgba(6, 182, 212, 0.35);
}

.btn-ghost {
  background: rgba(255, 255, 255, 0.15) !important;
  backdrop-filter: blur(12px);
  color: #ffffff !important;
  border: 1rpx solid rgba(255, 255, 255, 0.25) !important;
  border-radius: 20rpx !important;
}

.btn-danger-ghost {
  background: rgba(239, 68, 68, 0.2) !important;
  backdrop-filter: blur(8px);
  color: #ffffff !important;
  border: 1rpx solid rgba(239, 68, 68, 0.4) !important;
  border-radius: 20rpx !important;
}

/* 提示文本 */
.hint,
.empty {
  text-align: center;
  padding: 80rpx 24rpx;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.6);
}

/* 卡片 - 玻璃态版本 */
.card {
  background: rgba(255, 255, 255, 0.18);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 32rpx rgba(31, 38, 135, 0.15);
  color: #ffffff;
}

.goods-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #ffffff;
  margin-bottom: 12rpx;
}

.goods-meta {
  margin-top: 14rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  align-items: center;
  font-size: 24rpx;
}

.price {
  font-weight: 700;
}

.price-yuedou {
  color: #fbbf24;
}

.price-score {
  color: #60a5fa;
}

.stock {
  color: rgba(255, 255, 255, 0.7);
}

/* 标签 - 玻璃态版本 */
.badge {
  font-size: 22rpx;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
}

.badge-on {
  background: rgba(34, 197, 94, 0.3);
  backdrop-filter: blur(8px);
  border: 1rpx solid rgba(34, 197, 94, 0.4);
  color: #ffffff;
}

.badge-off {
  background: rgba(255, 255, 255, 0.15);
  backdrop-filter: blur(8px);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  color: rgba(255, 255, 255, 0.7);
}

.badge-cat {
  background: rgba(167, 139, 250, 0.3);
  backdrop-filter: blur(8px);
  border: 1rpx solid rgba(167, 139, 250, 0.4);
  color: #ffffff;
}

.badge-yuedou {
  background: rgba(251, 191, 36, 0.3);
  backdrop-filter: blur(8px);
  border: 1rpx solid rgba(251, 191, 36, 0.4);
  color: #ffffff;
}

.badge-score {
  background: rgba(59, 130, 246, 0.3);
  backdrop-filter: blur(8px);
  border: 1rpx solid rgba(59, 130, 246, 0.4);
  color: #ffffff;
}

.badge-wait {
  background: rgba(251, 146, 60, 0.3);
  backdrop-filter: blur(8px);
  border: 1rpx solid rgba(251, 146, 60, 0.4);
  color: #ffffff;
}

.badge-ship {
  background: rgba(59, 130, 246, 0.3);
  backdrop-filter: blur(8px);
  border: 1rpx solid rgba(59, 130, 246, 0.4);
  color: #ffffff;
}

.actions {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  justify-content: flex-end;
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.1);
}

/* 红包卡片 */
.red-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.red-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #ffffff;
  flex: 1;
  padding-right: 16rpx;
}

.red-body {
  background: rgba(255, 255, 255, 0.1);
  backdrop-filter: blur(12px);
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
}

.row {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  padding: 10rpx 0;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
}

.row + .row {
  border-top: 1rpx solid rgba(255, 255, 255, 0.1);
}

.muted {
  color: rgba(255, 255, 255, 0.6);
  flex-shrink: 0;
}

.addr {
  text-align: right;
  flex: 1;
  word-break: break-all;
  color: rgba(255, 255, 255, 0.85);
}

/* 弹窗 - 玻璃态版本 */
.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.sheet {
  width: 100%;
  max-height: 85vh;
  overflow-y: auto;
  background: rgba(30, 41, 59, 0.98);
  backdrop-filter: blur(24px);
  -webkit-backdrop-filter: blur(24px);
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx 28rpx calc(32rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  border-top: 1rpx solid rgba(255, 255, 255, 0.1);
}

.sheet-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #ffffff;
  margin-bottom: 28rpx;
  text-align: center;
}

.field {
  margin-bottom: 24rpx;
}

.field-row {
  display: flex;
  gap: 20rpx;
}

.field.half {
  flex: 1;
}

.label {
  display: block;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-bottom: 10rpx;
}

.input,
.textarea {
  width: 100%;
  box-sizing: border-box;
  background: rgba(255, 255, 255, 0.1);
  backdrop-filter: blur(12px);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: #ffffff;
}

.input::placeholder,
.textarea::placeholder {
  color: rgba(255, 255, 255, 0.5);
}

.textarea {
  min-height: 140rpx;
}

.seg {
  display: flex;
  gap: 16rpx;
}

.seg-i {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.7);
  background: rgba(255, 255, 255, 0.1);
  backdrop-filter: blur(8px);
  border: 1rpx solid rgba(255, 255, 255, 0.15);
  border-radius: 16rpx;
  transition: all 0.2s;
}

.seg-i.on {
  background: linear-gradient(135deg, #06b6d4 0%, #0891b2 100%);
  color: #ffffff;
  font-weight: 600;
  border-color: transparent;
  box-shadow: 0 4rpx 12rpx rgba(6, 182, 212, 0.3);
}

.sheet-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 32rpx;
}

.sheet-actions .wide {
  flex: 1;
}
